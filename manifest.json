{
  "manifest_version": 2,
  "name": "Redirect Manager",
  "version": "1.0.0",
  "description": "Redirect one website to another. Rules can be individually toggled or paused for a set time from the in-page manager panel.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["shared/rules-core.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/rules-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "redirect-manager@local.ext"
    }
  }
}
